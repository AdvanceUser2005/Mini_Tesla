<?xml version="1.0"?>
<!--
  Mini Tesla 10C4I - indoor mecanum robot (FINAL rev 2 chassis)
  ROS 2 Jazzy + Gazebo Harmonic.

  Frames: base_footprint on the floor under the robot centre; base_link = chassis underside centre
  (21 mm above the floor), the same origin as the CAD (+X forward, +Y left, +Z up).

  xacro args:
    drive        mecanum (default): wheels driven by gz MecanumDrive with 45-degree friction
                 planar: ideal holonomic base (VelocityControl), wheels slide; use if contact tuning bites
    side_radars  false (default) / true   radars on both side extensions
    rear_radar   false (default) / true
    laptop       true (default) / false   ASUS G14 on the deck (1.5 kg)
-->
<robot name="mini_tesla" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:arg name="drive" default="mecanum"/>
  <xacro:arg name="side_radars" default="false"/>
  <xacro:arg name="rear_radar" default="false"/>
  <xacro:arg name="laptop" default="true"/>

  <xacro:property name="pkg" value="$(find mini_tesla_description)"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- ===== geometry from the CAD (metres) ===== -->
  <xacro:property name="ground_clearance" value="0.021"/>
  <xacro:property name="wheel_radius" value="0.0375"/>
  <xacro:property name="wheel_width" value="0.0408"/>
  <xacro:property name="wheel_x" value="0.13305"/>       <!-- axle x, front +, rear - -->
  <xacro:property name="wheel_y" value="0.1344"/>        <!-- wheel centre y -->
  <xacro:property name="wheel_z" value="0.0165"/>        <!-- axle height in base_link -->
  <xacro:property name="body_len" value="0.3561"/>
  <xacro:property name="body_wid" value="0.279"/>        <!-- across the side extensions -->
  <xacro:property name="body_h" value="0.049"/>

  <!-- ===== masses (estimated: printed volume x 1.25 g/cc x ~60 % fill, datasheets for bought parts) ===== -->
  <xacro:property name="m_base" value="2.30"/>           <!-- printed chassis + mounts, 4 motors, drivers, boards -->
  <xacro:property name="m_deck" value="0.40"/>
  <xacro:property name="m_battery" value="0.80"/>
  <xacro:property name="m_laptop" value="1.50"/>
  <xacro:property name="m_wheel" value="0.12"/>          <!-- REV 75 mm mecanum + printed adapter -->
  <xacro:property name="m_camera" value="0.061"/>

  <!-- motor: Pololu 37D 19:1 -> ~530 rpm no-load = 55 rad/s -->
  <xacro:property name="wheel_vel_limit" value="55.0"/>
  <xacro:property name="wheel_effort_limit" value="0.6"/>

  <!-- ===== materials ===== -->
  <material name="chassis_white"><color rgba="0.90 0.90 0.87 1"/></material>
  <material name="deck_grey"><color rgba="0.33 0.34 0.37 1"/></material>
  <material name="orange"><color rgba="0.90 0.50 0.15 1"/></material>
  <material name="teal"><color rgba="0.20 0.60 0.55 1"/></material>
  <material name="motor_silver"><color rgba="0.72 0.73 0.76 1"/></material>
  <material name="pcb"><color rgba="0.12 0.30 0.18 1"/></material>
  <material name="black"><color rgba="0.10 0.10 0.11 1"/></material>
  <material name="battery_blue"><color rgba="0.25 0.35 0.65 1"/></material>
  <material name="laptop_grey"><color rgba="0.62 0.63 0.67 1"/></material>

  <!-- ===== inertia helpers ===== -->
  <xacro:macro name="box_inertial" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mesh_visual" params="name material">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://${pkg}/meshes/${name}.stl" scale="${mesh_scale}"/></geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <!-- ===================== BASE ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${ground_clearance}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:mesh_visual name="chassis" material="chassis_white"/>
    <xacro:mesh_visual name="mounts" material="orange"/>
    <xacro:mesh_visual name="sensor_mounts" material="teal"/>
    <xacro:mesh_visual name="motors" material="motor_silver"/>
    <xacro:mesh_visual name="electronics" material="pcb"/>
    <collision>
      <origin xyz="0 0 ${body_h/2}" rpy="0 0 0"/>
      <geometry><box size="${body_len} ${body_wid} ${body_h}"/></geometry>
    </collision>
    <xacro:box_inertial m="${m_base}" x="${body_len}" y="${body_wid}" z="0.06">
      <origin xyz="0.008 0 0.024" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <!-- laptop deck (2 halves + corner guards are in the mesh) -->
  <joint name="deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="deck_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="deck_link">
    <xacro:mesh_visual name="deck" material="deck_grey"/>
    <collision>
      <origin xyz="0 0 0.1045" rpy="0 0 0"/>
      <geometry><box size="0.329 0.238 0.011"/></geometry>
    </collision>
    <xacro:box_inertial m="${m_deck}" x="0.329" y="0.238" z="0.06">
      <origin xyz="0 0 0.095" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <!-- 6S 5200 mAh battery, crosswise in the centre bay -->
  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0 0 0.0255" rpy="0 0 0"/>
  </joint>
  <link name="battery_link">
    <visual>
      <geometry><box size="0.054 0.156 0.045"/></geometry>
      <material name="battery_blue"/>
    </visual>
    <xacro:box_inertial m="${m_battery}" x="0.054" y="0.156" z="0.045">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <!-- ASUS ROG Zephyrus G14 (lid closed), lying lengthwise on the deck -->
  <xacro:if value="$(arg laptop)">
    <joint name="laptop_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laptop_link"/>
      <origin xyz="0 0 0.11815" rpy="0 0 0"/>
    </joint>
    <link name="laptop_link">
      <visual>
        <geometry><box size="0.311 0.220 0.0163"/></geometry>
        <material name="laptop_grey"/>
      </visual>
      <collision>
        <geometry><box size="0.311 0.220 0.0163"/></geometry>
      </collision>
      <xacro:box_inertial m="${m_laptop}" x="0.311" y="0.220" z="0.0163">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>
  </xacro:if>

  <!-- ===================== WHEELS ===================== -->
  <!-- All wheel axes are +Y, so a positive joint velocity drives every wheel forward. -->
  <xacro:macro name="wheel" params="name x y side">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="${wheel_effort_limit}" velocity="${wheel_vel_limit}"/>
      <dynamics damping="0.002" friction="0.0"/>
    </joint>
    <link name="${name}_wheel_link">
      <visual>
        <geometry><mesh filename="file://${pkg}/meshes/wheel_${side}.stl" scale="${mesh_scale}"/></geometry>
        <material name="black"/>
      </visual>
      <!-- sphere contact: rolls cleanly in every direction; friction direction set in gazebo.xacro -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${m_wheel}"/>
        <inertia ixx="${m_wheel*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}" ixy="0" ixz="0"
                 iyy="${m_wheel*wheel_radius*wheel_radius/2}" iyz="0"
                 izz="${m_wheel*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"  side="left"/>
  <xacro:wheel name="front_right" x="${wheel_x}"  y="${-wheel_y}" side="right"/>
  <xacro:wheel name="rear_left"   x="${-wheel_x}" y="${wheel_y}"  side="left"/>
  <xacro:wheel name="rear_right"  x="${-wheel_x}" y="${-wheel_y}" side="right"/>

  <!-- ===================== SENSORS + GAZEBO ===================== -->
  <xacro:include filename="$(find mini_tesla_description)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find mini_tesla_description)/urdf/gazebo.xacro"/>

</robot>
