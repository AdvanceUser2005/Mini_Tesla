<?xml version="1.0"?>
<!--
  Gazebo Harmonic (gz-sim 8) systems for the 10C4I.
  Topics (gz side == ROS side through config/bridge.yaml):
    /cmd_vel (Twist in)   /odom (Odometry out)   /tf (odom -> base_footprint)   /joint_states
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:property name="drive" value="$(arg drive)"/>

  <!-- ===== wheel contact =====
       mecanum: grip 1.0 along a direction fixed in the chassis frame at 45 deg to the axle, 0 across it,
       which is what the rollers do (same pattern as gz-sim's mecanum_drive demo).
       planar: frictionless wheels; the base is moved directly by VelocityControl. -->
  <xacro:macro name="wheel_contact" params="name fdir">
    <gazebo reference="${name}_wheel_link">
      <collision>
        <surface>
          <friction>
            <ode>
              <xacro:if value="${drive == 'mecanum'}">
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="base_footprint">${fdir}</fdir1>
              </xacro:if>
              <xacro:unless value="${drive == 'mecanum'}">
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </xacro:unless>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_contact name="front_left"  fdir="1 -1 0"/>
  <xacro:wheel_contact name="front_right" fdir="1 1 0"/>
  <xacro:wheel_contact name="rear_left"   fdir="1 1 0"/>
  <xacro:wheel_contact name="rear_right"  fdir="1 -1 0"/>

  <!-- body skids: low friction so the chassis box never drags if it touches the floor -->
  <gazebo reference="base_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo>
    <xacro:if value="${drive == 'mecanum'}">
      <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>${2*wheel_y}</wheel_separation>
        <wheelbase>${2*wheel_x}</wheelbase>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <min_velocity>-1.5</min_velocity>
        <max_velocity>1.5</max_velocity>
        <min_acceleration>-3.0</min_acceleration>
        <max_acceleration>3.0</max_acceleration>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </xacro:if>

    <xacro:unless value="${drive == 'mecanum'}">
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </xacro:unless>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
