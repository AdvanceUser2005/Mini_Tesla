<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_bot">

    <!-- =========================
         COLORS
    ========================== -->

    <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>


    <!-- =========================
         BASE FOOTPRINT
    ========================== -->

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
    </joint>


    <!-- =========================
         ROBOT BODY
    ========================== -->

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.40 0.30 0.15"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.40 0.30 0.15"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="5.0"/>
            <inertia
                ixx="0.0469"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0833"
                iyz="0.0"
                izz="0.1302"/>
        </inertial>

    </link>


    <!-- =========================
         LEFT WHEEL
    ========================== -->

    <link name="left_wheel_link">

        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.001"
                iyz="0.0"
                izz="0.001"/>
        </inertial>

    </link>

    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel_link"/>

        <origin xyz="0 0.17 -0.02" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- =========================
         RIGHT WHEEL
    ========================== -->

    <link name="right_wheel_link">

        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.001"
                iyz="0.0"
                izz="0.001"/>
        </inertial>

    </link>

    <joint name="right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel_link"/>

        <origin xyz="0 -0.17 -0.02" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- =========================
         CASTER
    ========================== -->

    <link name="caster_link">

        <visual>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.1"/>
            <inertia
                ixx="0.0001"
                ixy="0"
                ixz="0"
                iyy="0.0001"
                iyz="0"
                izz="0.0001"/>
        </inertial>

    </link>

    <joint name="caster_joint" type="fixed">

        <parent link="base_link"/>
        <child link="caster_link"/>

        <origin xyz="-0.15 0 -0.075"/>

    </joint>


    <!-- =========================
         LIDAR
    ========================== -->

    <link name="lidar_link">

        <visual>
            <geometry>
                <cylinder radius="0.045" length="0.04"/>
            </geometry>
            <material name="black"/>
        </visual>

    </link>

    <joint name="lidar_joint" type="fixed">

        <parent link="base_link"/>
        <child link="lidar_link"/>

        <origin xyz="0.08 0 0.115"/>

    </joint>


</robot>